<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_pos_hobex" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.pos.hobex</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="point_of_sale.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <!--
            Inject a Hobex row at the end of the "Payment Terminals" block on
            the POS settings page. The same pattern as Adyen / Stripe / Tyro /
            etc.: a `module_pos_*` boolean toggles install/uninstall.
            (The arrow button that opens the matching payment method straight
            from here is a 19.0 addition - res.config.settings has no
            open_payment_method_form on 18.0, so the row is the toggle alone.)
            -->
            <xpath expr="//block[@id='pos_payment_terminals_section']" position="inside">
                <setting id="hobex_payment_terminal_setting"
                         title="The transactions are processed by Hobex. Set your Hobex credentials on the related payment method."
                         string="Hobex"
                         help="Accept payments with a Hobex payment terminal">
                    <field name="module_pos_hobex"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
