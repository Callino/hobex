<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inherit Form View to Modify it -->
    <record id="view_pos_payment_form_hobex" model="ir.ui.view">
        <field name="name">pos.payment.form Hobex</field>
        <field name="model">pos.payment</field>
        <field name="inherit_id" ref="point_of_sale.view_pos_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='session_id']/.." position="after">
                <group name="hobex" invisible="hobex_transactionId == False" string="Hobex Payment Details">
                    <group string="Transaction">
                        <field name="hobex_receipt"/>
                        <field name="hobex_approvalCode"/>
                        <field name="hobex_actionCode" invisible="hobex_actionCode == False"/>
                        <field name="hobex_aid" invisible="hobex_aid == False"/>
                        <field name="hobex_reference" invisible="hobex_reference == False"/>
                        <field name="hobex_tid"/>
                        <field name="hobex_transactionId"/>
                        <field name="hobex_transactionDate"/>
                        <field name="hobex_transactionType"/>
                    </group>
                    <group string="Card Details">
                        <field name="hobex_cardNumber"/>
                        <field name="hobex_cardExpiry"/>
                        <field name="hobex_brand"/>
                        <field name="hobex_cardIssuer"/>
                    </group>
                    <group string="Result">
                        <field name="hobex_responseCode"/>
                        <field name="hobex_responseText"/>
                        <field name="hobex_cvm"/>
                    </group>
                    <!--
                    Two distinct Hobex operations, deliberately kept apart:
                      * Storno (VOID)  - cancels the original transaction.
                        Only possible while Hobex has not closed the batch,
                        and only for a successful SELL.
                      * Gutschrift     - an independent credit via
                        /api/transaction/refund. Needs no reference to the
                        original sale, so it still works after the end of day,
                        but the customer has to present the card again.
                    -->
                    <group string="Refund" colspan="2">
                        <field name="hobex_refund_transaction_id" readonly="1"
                               invisible="hobex_refund_transaction_id == False"/>
                        <div colspan="2">
                            <button type="object" name="hobex_reversal"
                                    string="Reversal (VOID)" class="btn-secondary"
                                    invisible="hobex_transactionType != 'SELL' or hobex_responseText != 'OK'"
                                    help="Cancels the original transaction on the Hobex side. Only possible before the end of day."/>
                            <button type="object" name="hobex_refund"
                                    string="Refund (Credit)" class="btn-secondary ms-2"
                                    invisible="hobex_refund_transaction_id != False"
                                    confirm="A credit for the full payment amount will be booked on the terminal. The customer has to present the card for it. Continue?"
                                    help="Books an independent credit on the terminal. Works after the end of day, but the customer has to present the card."/>
                        </div>
                    </group>
                </group>
            </xpath>

        </field>
    </record>
</odoo>