<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <!--
    Hide the "Force done" button on Hobex payment lines and explain what a
    pending abort means.

    On 17.0 core renders "Force done" in exactly one branch of
    PaymentScreenPaymentLines - the 'force_done' one (connection error). The
    'waitingCard' branch offers "Cancel" and the
    'waiting' / 'waitingCancel' / 'waitingCapture' branch only a spinner, so
    the two extra XPaths the 18.0 version needs have no target here and are
    left out rather than carried over dead.

    The XPath sets the full t-if value explicitly so we don't depend on the
    `add`+separator concatenation (which can race when multiple XPath rules
    target overlapping elements — `locate_node` always returns the first
    match). OWL accepts the `and` keyword in expressions via WORD_REPLACEMENT
    (`and` -> `&amp;&amp;`), so we can keep Pythonic syntax.
    -->
    <t t-name="pos_hobex.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">

        <!-- 'force_done' branch button -->
        <xpath expr="//t[contains(@t-elif, 'force_done')]/div[hasclass('send_force_done')]" position="attributes">
            <attribute name="t-if">line.payment_method.use_payment_terminal != 'hobex'</attribute>
        </xpath>

        <!-- Status text of the waiting branch: while a Hobex abort is on its way,
             say what that means. Hobex acknowledging the command does not make the
             terminal stop - terminals in pinpad mode ignore it and run into their own
             timeout - so the cashier has to know that the gesture may have to be
             repeated on the device. The note is added below the running status, where
             it is needed, instead of replacing the status or opening a popup that has
             to be clicked away. -->
        <xpath expr="//t[contains(@t-elif, 'includes(line.payment_status)')]//div[hasclass('electronic_status')]" position="replace">
            <div class="electronic_status">
                Request sent
                <div t-if="line.payment_status == 'waitingCancel' and line.payment_method.use_payment_terminal == 'hobex'"
                     class="text-muted small">
                    Abort sent. If the terminal keeps asking for the card, cancel the payment on the terminal itself.
                </div>
            </div>
        </xpath>

    </t>

</templates>
