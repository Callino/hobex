<?xml version="1.0" encoding="UTF-8"?>
<templates id="template" xml:space="preserve">

    <t t-name="pos_hobex.PaymentScreenPaymentLines"
       t-inherit="point_of_sale.PaymentScreenPaymentLines"
       t-inherit-mode="extension">

        <!-- While a Hobex abort is on its way, say what that means. Hobex
             acknowledging the command does not make the terminal stop - terminals
             in pinpad mode ignore it and run into their own timeout - so the
             cashier has to know that the gesture may have to be repeated on the
             device. The note is added below the running status, next to "Force
             cancel" where it is needed, instead of replacing the status or opening
             a dialog that has to be clicked away. -->
        <xpath expr="//div[hasclass('paymentline_status_title')]" position="after">
            <div t-if="state.id == 'waiting_cancel' and line.payment_provider == 'hobex'"
                 class="text-muted small pb-3 px-4">
                Abort sent. If the terminal keeps asking for the card, cancel the payment on the terminal itself.
            </div>
        </xpath>

    </t>

</templates>
